@model List<LUMEN.ViewModels.UserRoleViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "User Management";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">User Management</h1>
            <p class="text-muted mb-0">Manage users and their system roles.</p>
        </div>

        <span class="badge bg-light text-dark border px-3 py-2">
            @Model.Count users
        </span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4 py-3">User</th>
                                <th class="py-3">Email</th>
                                <th class="py-3">Current Role</th>
                                <th class="py-3">Change Role</th>
                                <th class="py-3 text-end px-4">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>

                                    <td class="px-4">
                                        <div class="d-flex align-items-center gap-3">

                                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                                 style="
                                                    width:42px;
                                                    height:42px;
                                                    background:#C65D3E;
                                                    color:white;
                                                    font-weight:600;
                                                 ">
                                                @(string.IsNullOrWhiteSpace(user.UserName)
                                                    ? "?"
                                                    : user.UserName.Substring(0, 1).ToUpper())
                                            </div>

                                            <div>
                                                <div class="fw-semibold">
                                                    @user.UserName
                                                </div>
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @user.Email
                                        </span>
                                    </td>

                                    <td>
                                        @if (user.CurrentRole == "SuperAdmin")
                                        {
                                            <span class="badge bg-danger">
                                                SuperAdmin
                                            </span>
                                        }
                                       
                                       
                                        
                                        
                                        else if (user.CurrentRole == "Student")
                                        {
                                            <span class="badge bg-secondary">
                                                Student
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">
                                                @user.CurrentRole
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <form asp-controller="UserManagement"
                                              asp-action="UpdateRole"
                                              method="post"
                                              class="d-flex gap-2">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@user.UserId" />

                                            <select name="newRole"
                                                    class="form-select form-select-sm"
                                                    style="min-width:150px;">

                                                @foreach (var role in user.AvailableRoles)
                                                {
                                                    <option value="@role"
                                                            selected="@(role == user.CurrentRole)">
                                                        @role
                                                    </option>
                                                }

                                            </select>

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-arrow-repeat me-1"></i>
                                                Update
                                            </button>

                                        </form>
                                    </td>

                                    <td class="text-end px-4">
                                        <span class="text-muted small">
                                            ID: @user.UserId
                                        </span>
                                    </td>

                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-people"
                       style="font-size:3rem; color:#aaa;"></i>

                    <h4 class="mt-3">No users found</h4>

                    <p class="text-muted">
                        There are currently no users to manage.
                    </p>

                </div>
            }

        </div>
    </div>

</div>