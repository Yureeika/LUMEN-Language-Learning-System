@model IEnumerable<LUMEN.Models.Certificate>

@{
    ViewData["Title"] = "Certificates";
}

<div class="container-fluid mt-4">

    <div class="page-header">

        <h1>
            <i class="bi bi-patch-check-fill"></i>
            Certificates
        </h1>

        <p>
            Certificates you have earned from completing your learning activities.
        </p>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var certificate in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100">

                        <div class="card-body text-center p-4">

                            <i class="bi bi-patch-check-fill"
                               style="font-size: 3rem; color: var(--terracotta);">
                            </i>

                            <h4 class="mt-3">
                                Certificate
                            </h4>

                            @if (certificate.Subject != null)
                            {
                                <h5>
                                    @certificate.Subject.Title
                                </h5>
                            }

                            <p class="text-muted mt-3 mb-0">

                                Issued on

                                @certificate.IssuedAt
                                    .ToLocalTime()
                                    .ToString("dd MMMM yyyy")

                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card">

            <div class="card-body text-center py-5">

                <i class="bi bi-patch-check display-4 text-muted"></i>

                <h4 class="mt-3">
                    No certificates yet
                </h4>

                <p class="text-muted mb-0">
                    Complete your required learning activities to earn certificates.
                </p>

            </div>

        </div>
    }

</div>