@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - LUMEN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --terracotta: #C65D3E;
            --terracotta-hover: #A84A2E;
            --cream: #FAF6ED;
            --black: #1a1a1a;
            --gray: #6b6b6b;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--cream);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }
        
        .login-container {
            background: white;
            border: 1px solid #e5e5e5;
            border-radius: 8px;
            padding: 3rem;
            max-width: 450px;
            width: 100%;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        }
        
        .login-header {
            text-align: center;
            margin-bottom: 2.5rem;
        }
        
        .login-header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: var(--black);
            margin-bottom: 0.5rem;
        }
        
        .login-header p {
            color: var(--gray);
            font-size: 0.95rem;
        }
        
        .form-label {
            font-weight: 600;
            color: var(--black);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }
        
        .form-control {
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            transition: all 0.2s;
        }
        
        .form-control:focus {
            border-color: var(--terracotta);
            box-shadow: 0 0 0 3px rgba(198, 93, 62, 0.1);
            outline: none;
        }
        
        .form-check-label {
            color: var(--gray);
            font-size: 0.9rem;
        }
        
        .btn-login {
            background: var(--terracotta);
            border: none;
            color: white;
            padding: 1rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 4px;
            width: 100%;
            margin-top: 1.5rem;
            transition: all 0.3s;
        }
        
        .btn-login:hover {
            background: var(--terracotta-hover);
            transform: translateY(-1px);
        }
        
        .divider {
            text-align: center;
            margin: 1.5rem 0;
            color: var(--gray);
            font-size: 0.85rem;
            position: relative;
        }
        
        .divider::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 0;
            right: 0;
            height: 1px;
            background: #e5e5e5;
            z-index: 0;
        }
        
        .divider span {
            background: white;
            padding: 0 1rem;
            position: relative;
            z-index: 1;
        }
        
        .btn-guest {
            background: white;
            border: 1px solid #e5e5e5;
            color: var(--black);
            padding: 1rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 4px;
            width: 100%;
            transition: all 0.3s;
        }
        
        .btn-guest:hover {
            background: var(--cream);
            border-color: var(--black);
        }
        
        .login-footer {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.9rem;
            color: var(--gray);
        }
        
        .login-footer a {
            color: var(--terracotta);
            text-decoration: none;
            font-weight: 600;
        }
        
        .login-footer a:hover {
            text-decoration: underline;
        }
        
        .alert {
            border-radius: 4px;
            border: none;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .alert-danger {
            background: #fee;
            color: #c00;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-header">
            <h1>Login to LUMEN</h1>
            <p>Access your LUMEN account</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form action="/Account/Login" method="post">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="Email" class="form-control" required placeholder="you@example.com" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="Password" class="form-control" required placeholder="••••••••" />
            </div>

            <div class="mb-4 form-check">
                <input type="checkbox" name="RememberMe" class="form-check-input" id="rememberMe" />
                <label class="form-check-label" for="rememberMe">Remember me</label>
            </div>

            <button type="submit" class="btn btn-login">Login</button>
        </form>

        <div class="divider"><span>OR</span></div>

        <button onclick="window.location.href='/'" class="btn btn-guest">Continue as Guest</button>

        <div class="login-footer">
            <p>No account yet? <a href="/Account/Register">Create an account</a></p>
            <p style="margin-top: 0.75rem;"><a href="#">Forgot password?</a></p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>