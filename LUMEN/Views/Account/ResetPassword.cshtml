@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
    var userId = ViewBag.UserId as string;
    var code = ViewBag.Code as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - LUMEN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --terracotta: #C65D3E;
            --terracotta-hover: #A84A2E;
            --cream: #FAF6ED;
            --black: #1a1a1a;
            --gray: #6b6b6b;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--cream);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .container-box {
            background: white;
            border: 1px solid #e5e5e5;
            border-radius: 8px;
            padding: 3rem;
            max-width: 480px;
            width: 100%;
            box-shadow: 0 2px 12px rgba(0,0,0,0.05);
        }

        .logo-section {
            text-align: center;
            margin-bottom: 2rem;
        }

            .logo-section img {
                width: 60px;
                height: 60px;
                margin-bottom: 0.5rem;
            }

            .logo-section h1 {
                font-size: 1.8rem;
                font-weight: 700;
                color: var(--black);
                margin: 0;
            }

        .form-label {
            font-weight: 600;
            color: var(--black);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .form-control {
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            padding: 0.75rem 1rem;
            font-size: 1rem;
        }

            .form-control:focus {
                border-color: var(--terracotta);
                box-shadow: 0 0 0 3px rgba(198, 93, 62, 0.1);
            }

        .btn-submit {
            background: var(--terracotta);
            border: none;
            color: white;
            padding: 1rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 4px;
            width: 100%;
            margin-top: 1rem;
            transition: all 0.3s;
        }

            .btn-submit:hover {
                background: var(--terracotta-hover);
            }

        .alert {
            border-radius: 4px;
            border: none;
            padding: 1rem;
        }

        .alert-danger {
            background: #fee;
            color: #c00;
        }

        .password-hint {
            font-size: 0.8rem;
            color: var(--gray);
            margin-top: 0.25rem;
        }
    </style>
</head>
<body>
    <div class="container-box">
        <div class="logo-section">
            <img src="~/images/logo.png" alt="LUMEN" />
            <h1>LUMEN</h1>
            <p style="color: var(--gray); margin-top: 0.5rem;">Create a new password</p>
        </div>

        @if (ViewBag.Error != null)
        {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-circle"></i> @ViewBag.Error
        </div>
        }

        <form action="/Account/ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserId" value="@userId" />
            <input type="hidden" name="Code" value="@code" />

            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input type="password" name="Password" class="form-control" required placeholder="••••••••" />
                <div class="password-hint">Minimum 8 characters with uppercase, lowercase, number, and special character</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Confirm New Password</label>
                <input type="password" name="ConfirmPassword" class="form-control" required placeholder="••••••••" />
            </div>

            <button type="submit" class="btn-submit">
                <i class="bi bi-shield-lock"></i> Reset Password
            </button>
        </form>
    </div>
</body>
</html>