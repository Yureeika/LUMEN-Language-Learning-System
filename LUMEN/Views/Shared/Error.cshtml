@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-danger">Error</h1>
    <p class="lead">An error occurred while processing your request.</p>
    @if (Model?.RequestId != null)
    {
        <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
    <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3"><i class="bi bi-house"></i> Return to Home</a>
</div>