<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LUMEN</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

        :root {
            --terracotta: #C65D3E;
            --terracotta-hover: #A84A2E;
            --terracotta-light: rgba(198, 93, 62, 0.1);

            --olive: #7A8B5C;
            --olive-light: rgba(122, 139, 92, 0.1);

            --cream: #FAF6ED;
            --cream-dark: #F0E8D5;

            --navy: #1E1E2E;
            --navy-light: #2a2a3e;

            --black: #1a1a1a;

            --gray: #6b6b6b;
            --gray-light: #f5f5f5;

            --success: #2E7D32;
            --warning: #F59E0B;
            --danger: #DC2626;
            --info: #3B82F6;
        }


        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html,
        body {
            min-height: 100%;
        }


        body {
            font-family: 'Inter', sans-serif;
            background: var(--cream);
            color: var(--black);
            line-height: 1.6;
        }


        /* ==========================================
           STUDENT WRAPPER
           ========================================== */

        .student-wrapper {
            display: flex;
            min-height: 100vh;
        }


        /* ==========================================
           SIDEBAR
           ========================================== */

        .student-sidebar {
            width: 260px;

            background: var(--navy);
            color: white;

            position: fixed;

            left: 0;
            top: 0;

            height: 100vh;

            overflow-y: auto;
            overflow-x: hidden;

            z-index: 1000;

            transition: transform 0.3s ease;

            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.25) transparent;
        }


        /* Chrome / Edge / Safari scrollbar */

        .student-sidebar::-webkit-scrollbar {
            width: 7px;
        }

        .student-sidebar::-webkit-scrollbar-track {
            background: transparent;
        }

        .student-sidebar::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.25);
            border-radius: 10px;
        }

        .student-sidebar::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,0.4);
        }


        /* Collapsed sidebar */

       .student-sidebar.collapsed {
    width: 90px;
    transform: translateX(0);
}


        .student-sidebar.collapsed .sidebar-brand,
        .student-sidebar.collapsed .sidebar-link span,
        .student-sidebar.collapsed .sidebar-section {
            display: none;
        }


        .student-sidebar.collapsed .sidebar-link {
            justify-content: center;
            padding: 0.75rem;
        }


        /* ==========================================
           SIDEBAR HEADER
           ========================================== */

        .sidebar-header {
            padding: 1.5rem;

            border-bottom: 1px solid rgba(255,255,255,0.1);

            display: flex;
            align-items: center;

            gap: 0.75rem;

            position: sticky;
            top: 0;

            background: var(--navy);

            z-index: 5;
        }


        .sidebar-logo {
            width: 40px;
            height: 40px;

            object-fit: contain;
        }


        .sidebar-brand {
            font-size: 1.25rem;

            font-weight: 700;

            letter-spacing: 1px;
        }


        /* ==========================================
           SIDEBAR NAV
           ========================================== */

        .sidebar-nav {
            padding: 1rem 0 2rem 0;
        }


        .sidebar-section {
            padding: 0.75rem 1.5rem 0.5rem;

            font-size: 0.7rem;

            text-transform: uppercase;

            letter-spacing: 1.5px;

            color: rgba(255,255,255,0.5);

            font-weight: 600;
        }


        .sidebar-link {
            display: flex;

            align-items: center;

            gap: 0.75rem;

            padding: 0.75rem 1.5rem;

            color: rgba(255,255,255,0.8);

            text-decoration: none;

            transition:
                background-color 0.2s ease,
                color 0.2s ease;

            font-weight: 500;

            font-size: 0.9rem;

            width: 100%;

            border: none;

            background: transparent;

            cursor: pointer;

            text-align: left;
        }


        .sidebar-link:hover {
            background: rgba(255,255,255,0.06);

            color: white;
        }


        .sidebar-link.active {
            background: var(--terracotta);

            color: white;
        }


        .sidebar-link i {
            font-size: 1.1rem;

            width: 20px;

            min-width: 20px;

            text-align: center;
        }


        /* ==========================================
           MAIN CONTENT
           ========================================== */

     .student-main {
    flex: 1;
    margin-left: 260px;
    min-height: 100vh;
    min-width: 0;
    width: calc(100% - 260px);
    transition: margin-left 0.3s ease, width 0.3s ease;
}

.student-sidebar.collapsed ~ .student-main {
    margin-left: 90px;
    width: calc(100% - 90px);
}
        /* ==========================================
           TOP BAR
           ========================================== */

        .student-topbar {
            background: var(--navy);

            color: white;

            padding: 1rem 2rem;

            display: flex;

            justify-content: space-between;

            align-items: center;

            border-bottom: 1px solid rgba(255,255,255,0.08);

            position: sticky;

            top: 0;

            z-index: 900;

            gap: 1rem;
        }


        .topbar-left {
            display: flex;

            align-items: center;

            gap: 1rem;

            flex: 1;
        }


        /* ==========================================
           HAMBURGER
           ========================================== */

        .hamburger-btn {
            background: transparent;

            border: none;

            font-size: 1.5rem;

            cursor: pointer;

            color: white;

            padding: 0.5rem;

            border-radius: 6px;

            transition: background 0.2s;
        }


        .hamburger-btn:hover {
            background: rgba(255,255,255,0.08);
        }


        /* ==========================================
           SEARCH
           ========================================== */

        .topbar-search {
            display: flex;

            align-items: center;

            background: rgba(255,255,255,0.08);

            border: 1px solid rgba(255,255,255,0.08);

            border-radius: 10px;

            padding: 0.5rem 1rem;

            max-width: 565px;

            flex: 1;

            color: rgba(255,255,255,0.7);
        }


        .topbar-search input {
            background: transparent;

            border: none;

            outline: none;

            margin-left: 0.5rem;

            width: 100%;

            font-size: 0.9rem;

            color: white;
        }


        .topbar-search input::placeholder {
            color: rgba(255,255,255,0.55);
        }


        /* ==========================================
           TOPBAR ACTIONS
           ========================================== */

        .topbar-actions {
            display: flex;

            align-items: center;

            gap: 1rem;
        }


        .topbar-icon {
            width: 40px;
            height: 40px;

            border-radius: 50%;

            background: rgba(255,255,255,0.08);

            color: white;

            display: flex;

            align-items: center;

            justify-content: center;

            cursor: pointer;

            position: relative;

            transition: all 0.2s;

            border: none;

            font-size: 1.1rem;
        }


        .topbar-icon:hover {
            background: rgba(255,255,255,0.15);
        }


        .notification-badge {
            position: absolute;

            top: -2px;

            right: -2px;

            background: var(--danger);

            color: white;

            font-size: 0.7rem;

            width: 18px;
            height: 18px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: 600;
        }


        /* ==========================================
           USER DROPDOWN
           ========================================== */

        .user-dropdown {
            display: flex;

            align-items: center;

            gap: 0.75rem;

            cursor: pointer;

            padding: 0.5rem 1rem;

            border-radius: 8px;

            transition: all 0.2s;

            color: white;
        }


        .user-dropdown:hover {
            background: rgba(255,255,255,0.08);
        }


        .user-avatar {
            width: 36px;
            height: 36px;

            border-radius: 50%;

            background: var(--terracotta);

            color: white;

            display: flex;

            align-items: center;

            justify-content: center;

            font-weight: 600;
        }

        /* ==========================================
   STUDENT PROFILE DROPDOWN
   ========================================== */

.student-profile-menu {
    min-width: 220px;

    margin-top: 0.5rem;

    border: 1px solid rgba(0,0,0,0.08);

    border-radius: 10px;

    box-shadow:
        0 8px 24px rgba(0,0,0,0.12);

    padding: 0.5rem;
}


.student-profile-menu .dropdown-item {
    border-radius: 7px;

    padding: 0.6rem 0.75rem;

    font-size: 0.9rem;

    font-weight: 500;
}


.student-profile-menu .dropdown-item:hover {
    background: var(--cream);

    color: var(--black);
}


.student-profile-menu .dropdown-item.text-danger:hover {
    background: rgba(220,38,38,0.08);

    color: var(--danger) !important;
}


/* Remove Bootstrap's default arrow styling
   from the existing profile appearance */

.user-dropdown.dropdown-toggle::after {
    margin-left: 0.35rem;
}


/* Keep the profile button looking like
   the existing student panel */

.user-dropdown {
    border: none;

    background: transparent;

    color: white;
}


.user-dropdown:focus {
    box-shadow: none;

    outline: none;
}

        /* ==========================================
           CONTENT
           ========================================== */

        .student-content {
            padding: 2rem;

            min-height: calc(100vh - 73px);
        }


        /* ==========================================
           PAGE HEADER
           ========================================== */

        .page-header {
            margin-bottom: 2rem;
        }


        .page-header h1 {
            font-weight: 700;
        }


        .page-header p {
            color: var(--gray);
        }


        /* ==========================================
           CARDS
           ========================================== */

        .card {
            border: 1px solid rgba(0,0,0,0.08);

            border-radius: 12px;

            background: white;

            box-shadow:
                0 2px 8px rgba(0,0,0,0.04);
        }


        .card-title {
            color: var(--black);
        }


        /* ==========================================
           BUTTONS
           ========================================== */

        .btn-primary,
        a.btn-primary,
        button.btn-primary {

            background-color: var(--terracotta) !important;

            border-color: var(--terracotta) !important;

            color: white !important;

            font-weight: 600;

            border-radius: 8px;

            padding: 0.625rem 1.25rem;
        }


        .btn-primary:hover,
        .btn-primary:focus,
        .btn-primary:active,
        a.btn-primary:hover,
        a.btn-primary:focus,
        a.btn-primary:active,
        button.btn-primary:hover,
        button.btn-primary:focus,
        button.btn-primary:active {

            background-color: var(--terracotta-hover) !important;

            border-color: var(--terracotta-hover) !important;

            color: white !important;
        }


        /* ==========================================
           OLIVE BUTTON
           ========================================== */

        .btn-olive {

            background-color: var(--olive) !important;

            border-color: var(--olive) !important;

            color: white !important;

            font-weight: 600;

            border-radius: 8px;
        }


        .btn-olive:hover {

            background-color: #657448 !important;

            border-color: #657448 !important;

            color: white !important;
        }


        /* ==========================================
           ALERTS
           ========================================== */

        .alert-info {

            background-color: var(--cream-dark);

            border-color: rgba(122,139,92,0.3);

            color: var(--black);
        }


        /* ==========================================
           MOBILE
           ========================================== */

        @@media (max-width: 768px) {

            .student-sidebar {

                transform: translateX(-260px);

            }


            .student-sidebar.mobile-open {

                transform: translateX(0);

            }


            .student-main {
    margin-left: 0 !important;
}


            .topbar-search {

                display: none;

            }


            .student-topbar {

                padding: 0.75rem 1rem;

            }


            .student-content {

                padding: 1rem;

            }


            .user-dropdown span {

                display: none;

            }

        }

    </style>
</head>


<body>

    <div class="student-wrapper">

        <!-- ==========================================
             SIDEBAR
             ========================================== -->

        <aside class="student-sidebar" id="sidebar">

            <div class="sidebar-header">

                <img src="~/images/logo.png"
                     alt="LUMEN"
                     class="sidebar-logo" />

                <span class="sidebar-brand">
                    LUMEN
                </span>

            </div>


            <nav class="sidebar-nav">

                @{

                    var ctrl =
                        ViewContext.RouteData.Values["controller"]?.ToString()
                        ?? "";

                    var act =
                        ViewContext.RouteData.Values["action"]?.ToString()
                        ?? "";

                }


                <!-- ==================================
                     MAIN
                     ================================== -->

                <div class="sidebar-section">
                    Main
                </div>


                <a asp-controller="Home"
                   asp-action="Dashboard"
                   class="sidebar-link @(ctrl == "Home" && act == "Dashboard" ? "active" : "")">

                    <i class="bi bi-speedometer2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <a asp-controller="Subjects"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Subjects" ? "active" : "")">

                    <i class="bi bi-book-fill"></i>

                    <span>
                        Browse Subjects
                    </span>

                </a>


                <a asp-controller="MySubjects"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "MySubjects" ? "active" : "")">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        My Subjects
                    </span>

                </a>


                <!-- ==================================
                     CONTENT
                     ================================== -->

                <div class="sidebar-section">
                    Content
                </div>


                <a asp-controller="Lessons"
   asp-action="Index"
   class="sidebar-link @(ctrl == "Lessons" ? "active" : "")">

    <i class="bi bi-journal-text"></i>

    <span>
        Lessons
    </span>

</a>

                <a asp-controller="DailyQuiz"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "DailyQuiz" ? "active" : "")">

                    <i class="bi bi-question-circle-fill"></i>

                    <span>
                        Daily Quiz
                    </span>

                </a>


                <a asp-controller="DailyTrack"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "DailyTrack" ? "active" : "")">

                    <i class="bi bi-calendar-check-fill"></i>

                    <span>
                        Daily Track
                    </span>

                </a>

                <a asp-controller="Announcements"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Announcements" ? "active" : "")">

                    <i class="bi bi-megaphone-fill"></i>

                    <span>
                        Announcements
                    </span>

                </a>

                <!-- ==================================
                     LEARNING
                     ================================== -->

                <div class="sidebar-section">
                    Learning
                </div>


                <a asp-controller="VirtualLab"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "VirtualLab" ? "active" : "")">

                    <i class="bi bi-code-slash"></i>

                    <span>
                        Virtual Lab
                    </span>

                </a>


                <a asp-controller="Bookmarks"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Bookmarks" ? "active" : "")">

                    <i class="bi bi-bookmark-fill"></i>

                    <span>
                        Bookmarks
                    </span>

                </a>


                <a asp-controller="Notes"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Notes" ? "active" : "")">

                    <i class="bi bi-journal-text"></i>

                    <span>
                        Notes
                    </span>

                </a>


                <!-- ==================================
                     COMMUNITY
                     ================================== -->

                <div class="sidebar-section">
                    Community
                </div>

                <a asp-controller="Chat"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Chat" ? "active" : "")">

                    <i class="bi bi-chat-dots-fill"></i>

                    <span>
                        Chat
                    </span>

                </a>


                <a asp-controller="Forum"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Forum" ? "active" : "")">

                    <i class="bi bi-chat-square-text-fill"></i>

                    <span>
                        Forum
                    </span>

                </a>


                <!-- ==================================
                     ACHIEVEMENTS
                     ================================== -->

                <div class="sidebar-section">
                    Achievements
                </div>


                <a asp-controller="Badges"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Badges" ? "active" : "")">

                    <i class="bi bi-award-fill"></i>

                    <span>
                        Badges
                    </span>

                </a>


                <a asp-controller="Certificates"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Certificates" ? "active" : "")">

                    <i class="bi bi-patch-check-fill"></i>

                    <span>
                        Certificates
                    </span>

                </a>


                <a asp-controller="Leaderboard"
                   asp-action="Index"
                   class="sidebar-link @(ctrl == "Leaderboard" ? "active" : "")">

                    <i class="bi bi-trophy-fill"></i>

                    <span>
                        Leaderboard
                    </span>

                </a>


                <!-- ==================================
                     ACCOUNT
                     ================================== -->

                <div class="sidebar-section mt-4">
                    Account
                </div>


                <a asp-controller="Home"
                   asp-action="Profile"
                   class="sidebar-link @(ctrl == "Home" && act == "Profile" ? "active" : "")">

                    <i class="bi bi-person-fill"></i>

                    <span>
                        My Profile
                    </span>

                </a>


              


                <!-- LOGOUT -->

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="m-0">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="sidebar-link">

                        <i class="bi bi-box-arrow-right"></i>

                        <span>
                            Logout
                        </span>

                    </button>

                </form>

            </nav>

        </aside>


        <!-- ==========================================
             MAIN CONTENT
             ========================================== -->

        <main class="student-main">


            <!-- ======================================
                 TOP BAR
                 ====================================== -->

            <div class="student-topbar">


                <div class="topbar-left">

                    <button class="hamburger-btn"
                            type="button"
                            onclick="toggleSidebar()">

                        <i class="bi bi-list"></i>

                    </button>


                    <div class="topbar-search">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Search courses..." />

                    </div>

                </div>


                <!-- TOPBAR ACTIONS -->

                <div class="topbar-actions">


                    <!-- Notifications -->

                    <div class="topbar-icon">

                        <i class="bi bi-bell"></i>

                        <span class="notification-badge">
                            0
                        </span>

                    </div>


                 <!-- User Profile Dropdown -->

<div class="dropdown">

    <button class="user-dropdown dropdown-toggle"
            type="button"
            id="studentProfileDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false">

        <div class="user-avatar">

            @{

                var userName =
                    User.Identity?.Name ?? "User";

                var userInitial =
                    userName.Length > 0
                        ? userName.Substring(0, 1).ToUpper()
                        : "U";

            }

            @userInitial

        </div>


        <span>
            @userName
        </span>

    </button>


    <ul class="dropdown-menu dropdown-menu-end student-profile-menu"
        aria-labelledby="studentProfileDropdown">

        <li class="px-3 py-2">

            <div class="fw-semibold">
                @userName
            </div>

            <small class="text-muted">
                Student
            </small>

        </li>


        <li>
            <hr class="dropdown-divider" />
        </li>


        <li>

            <a class="dropdown-item"
               asp-controller="Home"
               asp-action="Profile">

                <i class="bi bi-person-fill me-2"></i>
                My Profile

            </a>

        </li>


        <li>

            <a class="dropdown-item"
               asp-controller="Settings"
               asp-action="Index">

                <i class="bi bi-gear-fill me-2"></i>
                Settings

            </a>

        </li>


        <li>
            <hr class="dropdown-divider" />
        </li>


        <li>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="m-0">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="dropdown-item text-danger">

                    <i class="bi bi-box-arrow-right me-2"></i>
                    Logout

                </button>

            </form>

        </li>

    </ul>

</div>

                </div>

            </div>


            <!-- ======================================
                 PAGE CONTENT
                 ====================================== -->

            <div class="student-content">

                @RenderBody()

            </div>


        </main>

    </div>


    <!-- ==========================================
         BOOTSTRAP
         ========================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- ==========================================
         SIDEBAR JAVASCRIPT
         ========================================== -->

    <script>

        /*
         * ==========================================
         * RESTORE SIDEBAR POSITION
         * ==========================================
         */

        document.addEventListener("DOMContentLoaded", function () {

            const sidebar =
                document.getElementById("sidebar");

            if (!sidebar) {
                return;
            }


            const savedPosition =
                sessionStorage.getItem(
                    "lumenSidebarScroll"
                );


            if (savedPosition !== null) {

                sidebar.scrollTop =
                    parseInt(savedPosition, 10);

            }


            /*
             * Save whenever sidebar scrolls
             */

            sidebar.addEventListener(
                "scroll",
                function () {

                    sessionStorage.setItem(
                        "lumenSidebarScroll",
                        sidebar.scrollTop
                    );

                }
            );


            /*
             * Save before clicking a navigation link
             */

            const links =
                sidebar.querySelectorAll(
                    "a.sidebar-link"
                );


            links.forEach(function (link) {

                link.addEventListener(
                    "click",
                    function () {

                        sessionStorage.setItem(
                            "lumenSidebarScroll",
                            sidebar.scrollTop
                        );

                    }
                );

            });


            /*
             * Save before leaving the page
             */

            window.addEventListener(
                "beforeunload",
                function () {

                    sessionStorage.setItem(
                        "lumenSidebarScroll",
                        sidebar.scrollTop
                    );

                }
            );

        });


        /*
         * ==========================================
         * TOGGLE SIDEBAR
         * ==========================================
         */

        function toggleSidebar() {

            const sidebar =
                document.getElementById("sidebar");


            if (!sidebar) {
                return;
            }


            if (window.innerWidth <= 768) {

                sidebar.classList.toggle(
                    "mobile-open"
                );

            }
            else {

                sidebar.classList.toggle(
                    "collapsed"
                );

            }

        }

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>
</html>