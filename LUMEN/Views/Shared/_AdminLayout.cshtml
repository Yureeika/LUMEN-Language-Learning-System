<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LUMEN Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --terracotta: #C65D3E;
            --terracotta-hover: #A84A2E;
            --terracotta-light: rgba(198, 93, 62, 0.1);
            --olive: #7A8B5C;
            --olive-light: rgba(122, 139, 92, 0.1);
            --cream: #FAF6ED;
            --cream-dark: #F0E8D5;
            --navy: #1E1E2E;
            --navy-light: #2a2a3e;
            --black: #1a1a1a;
            --gray: #6b6b6b;
            --gray-light: #f5f5f5;
            --success: #2E7D32;
            --warning: #F59E0B;
            --danger: #DC2626;
            --info: #3B82F6;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--gray-light);
            color: var(--black);
            line-height: 1.6;
        }

        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .admin-sidebar {
            width: 260px;
            background: var(--navy);
            color: white;
            position: fixed;
            height: 100vh;
            overflow-y: auto;
            transition: all 0.3s ease;
            z-index: 100;
        }

        .admin-sidebar.collapsed {
            width: 70px;
        }

        .admin-sidebar.collapsed .sidebar-brand,
        .admin-sidebar.collapsed .sidebar-link span,
        .admin-sidebar.collapsed .sidebar-section {
            display: none;
        }

        .admin-sidebar.collapsed .sidebar-link {
            justify-content: center;
            padding: 0.75rem;
        }

        .admin-sidebar.collapsed .sidebar-link i {
            margin: 0;
        }

        .sidebar-header {
            padding: 1.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .sidebar-logo {
            width: 40px;
            height: 40px;
            object-fit: contain;
        }

        .sidebar-brand {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .sidebar-nav {
            padding: 1rem 0;
        }

        .sidebar-section {
            padding: 0.75rem 1.5rem 0.5rem;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: rgba(255,255,255,0.5);
            font-weight: 600;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1.5rem;
            color: rgba(255,255,255,0.8);
            text-decoration: none;
            transition: all 0.2s;
            font-weight: 500;
            font-size: 0.9rem;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

        .sidebar-link:hover {
            background: rgba(255,255,255,0.05);
            color: white;
        }

        .sidebar-link.active {
            background: var(--terracotta);
            color: white;
        }

        .sidebar-link i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }

        /* Main Content */
        .admin-main {
            flex: 1;
            margin-left: 260px;
            min-height: 100vh;
            transition: margin-left 0.3s ease;
        }

        .admin-sidebar.collapsed ~ .admin-main {
            margin-left: 70px;
        }

        /* Top Bar */
        .admin-topbar {
            background: white;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #e5e5e5;
            position: sticky;
            top: 0;
            z-index: 50;
            gap: 1rem;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex: 1;
        }

        .hamburger-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--navy);
            padding: 0.5rem;
            border-radius: 6px;
            transition: background 0.2s;
        }

        .hamburger-btn:hover {
            background: var(--gray-light);
        }

        .topbar-search {
            display: flex;
            align-items: center;
            background: var(--gray-light);
            border-radius: 6px;
            padding: 0.5rem 1rem;
            max-width: 400px;
            flex: 1;
        }

        .topbar-search input {
            background: transparent;
            border: none;
            outline: none;
            margin-left: 0.5rem;
            width: 100%;
            font-size: 0.9rem;
        }

        .topbar-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .topbar-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--gray-light);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
            transition: all 0.2s;
            border: none;
            font-size: 1.1rem;
        }

        .topbar-icon:hover {
            background: var(--cream-dark);
        }

        .notification-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            background: var(--danger);
            color: white;
            font-size: 0.7rem;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        /* Dropdowns */
        .dropdown-menu-custom {
            position: absolute;
            top: 100%;
            right: 0;
            background: white;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            min-width: 280px;
            max-height: 400px;
            overflow-y: auto;
            display: none;
            z-index: 200;
            margin-top: 0.5rem;
        }

        .dropdown-menu-custom.show {
            display: block;
        }

        .dropdown-header {
            padding: 1rem;
            border-bottom: 1px solid #e5e5e5;
            font-weight: 600;
            color: var(--navy);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .dropdown-item-custom {
            padding: 0.75rem 1rem;
            border-bottom: 1px solid #f5f5f5;
            cursor: pointer;
            transition: background 0.2s;
        }

        .dropdown-item-custom:hover {
            background: var(--gray-light);
        }

        .dropdown-item-custom:last-child {
            border-bottom: none;
        }

        .notification-item .notif-title {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--navy);
        }

        .notification-item .notif-message {
            font-size: 0.8rem;
            color: var(--gray);
            margin-top: 0.25rem;
        }

        .notification-item .notif-meta {
            font-size: 0.75rem;
            color: var(--gray);
            margin-top: 0.25rem;
        }

        .notif-type-badge {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border-radius: 4px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-right: 0.5rem;
        }

        .notif-type-badge.feedback {
            background: rgba(59, 130, 246, 0.1);
            color: var(--info);
        }

        .notif-type-badge.complaint {
            background: rgba(220, 38, 38, 0.1);
            color: var(--danger);
        }

        .notif-type-badge.review {
            background: rgba(46, 125, 50, 0.1);
            color: var(--success);
        }

        .user-dropdown {
            position: relative;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            cursor: pointer;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            transition: all 0.2s;
        }

        .user-dropdown:hover {
            background: var(--gray-light);
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--terracotta);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 0.9rem;
        }

        .profile-dropdown .dropdown-item-custom {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .profile-dropdown .dropdown-item-custom i {
            width: 20px;
            color: var(--gray);
        }

        .profile-dropdown .user-info {
            padding: 1rem;
            border-bottom: 1px solid #e5e5e5;
        }

        .profile-dropdown .user-name {
            font-weight: 600;
            color: var(--navy);
        }

        .profile-dropdown .user-email {
            font-size: 0.8rem;
            color: var(--gray);
        }

        /* Content */
        .admin-content {
            padding: 2rem;
        }

        @@media (max-width: 768px) {
            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-sidebar.mobile-open {
                transform: translateX(0);
                width: 260px;
            }

            .admin-main {
                margin-left: 0 !important;
            }

            .topbar-search {
                display: none;
            }
        }
    </style>
</head>

<body>

    <div class="admin-wrapper">

        <!-- Sidebar -->
        <aside class="admin-sidebar" id="sidebar">

            <div class="sidebar-header">
                <img src="~/images/logo.png" alt="LUMEN" class="sidebar-logo" />
                <span class="sidebar-brand">LUMEN</span>
            </div>

            <nav class="sidebar-nav">

                <div class="sidebar-section">Main</div>

                <a href="/Home/AdminDashboard"
                   class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AdminDashboard" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                <a href="/Subjects" class="sidebar-link">
                    <i class="bi bi-book-fill"></i>
                    <span>Subjects</span>
                </a>

                <a href="/UserManagement" class="sidebar-link">
                    <i class="bi bi-people-fill"></i>
                    <span>Users</span>
                </a>

                <div class="sidebar-section">Content</div>

                <a href="/Lessons" class="sidebar-link">
                    <i class="bi bi-journal-text"></i>
                    <span>Lessons</span>
                </a>

                <a href="/Announcements" class="sidebar-link">
                    <i class="bi bi-megaphone-fill"></i>
                    <span>Announcements</span>
                </a>

                <a href="/Quizzes" class="sidebar-link">
                    <i class="bi bi-question-circle-fill"></i>
                    <span>Quizzes</span>
                </a>

                <div class="sidebar-section">System</div>

                <a href="/AuditLog" class="sidebar-link">
                    <i class="bi bi-shield-lock-fill"></i>
                    <span>Audit Log</span>
                </a>

                <a href="/Settings" class="sidebar-link">
                    <i class="bi bi-gear-fill"></i>
                    <span>Settings</span>
                </a>

                <div class="sidebar-section mt-4">
                </div>

            </nav>

        </aside>

        <!-- Main Content -->
        <main class="admin-main">

            <!-- Top Bar -->
            <div class="admin-topbar">

                <div class="topbar-left">

                    <button class="hamburger-btn" onclick="toggleSidebar()">
                        <i class="bi bi-list"></i>
                    </button>

                    <form action="/Home/AdminSearch" method="get" class="topbar-search">

                        <i class="bi bi-search" style="color: var(--gray);"></i>

                        <input type="text"
                               name="query"
                               placeholder="Search users, subjects, announcements..."
                               required />

                    </form>

                </div>

                <div class="topbar-actions">

                    <!-- Notifications -->
                    <div style="position: relative;">

                        <button class="topbar-icon"
                                onclick="toggleDropdown('notifDropdown')">

                            <i class="bi bi-bell"></i>

                            <span class="notification-badge" id="notifCount">
                                0
                            </span>

                        </button>

                        <div class="dropdown-menu-custom"
                             id="notifDropdown">

                            <div class="dropdown-header">

                                <span>Notifications</span>

                                <a href="/Feedback"
                                   style="font-size: 0.8rem; color: var(--terracotta);">
                                    View All
                                </a>

                            </div>

                            <div id="notifList">

                                <div class="dropdown-item-custom"
                                     style="text-align: center; color: var(--gray);">

                                    Loading...

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Profile Dropdown -->
                    <div style="position: relative;">

                        <div class="user-dropdown"
                             onclick="toggleDropdown('profileDropdown')">

                            <div class="user-avatar">

                                @if (!string.IsNullOrEmpty(User.Identity?.Name))
                                {
                                    @User.Identity.Name.Substring(0, 1).ToUpper()
                                }
                                else
                                {
                                    <span>U</span>
                                }

                            </div>

                            <span>@User.Identity?.Name</span>

                            <i class="bi bi-chevron-down"></i>

                        </div>

                        <div class="dropdown-menu-custom profile-dropdown"
                             id="profileDropdown">

                            <div class="user-info">

                                <div class="user-name">
                                    @User.Identity?.Name
                                </div>

                                <div class="user-email">
                                    Administrator
                                </div>

                            </div>

                            <!-- My Profile -->
                            <a href="/Home/Profile"
                               class="dropdown-item-custom">

                                <i class="bi bi-person"></i>

                                My Profile

                            </a>

                            <!-- FIXED: Settings now goes to Settings -->
                            <a href="/Settings"
                               class="dropdown-item-custom">

                                <i class="bi bi-gear"></i>

                                Settings

                            </a>

                            <!-- Logout -->
                            <form action="/Account/Logout"
                                  method="post"
                                  style="margin: 0;">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="dropdown-item-custom"
                                        style="width: 100%; border: none; background: none; text-align: left; cursor: pointer;">

                                    <i class="bi bi-box-arrow-right"></i>

                                    Logout

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Content -->
            <div class="admin-content">

                @RenderBody()

            </div>

        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        // Sidebar toggle
        function toggleSidebar() {

            const sidebar =
                document.getElementById('sidebar');

            if (window.innerWidth <= 768) {

                sidebar.classList.toggle('mobile-open');

            } else {

                sidebar.classList.toggle('collapsed');

            }

        }

        // Dropdown toggle
        function toggleDropdown(id) {

            const dropdown =
                document.getElementById(id);

            const allDropdowns =
                document.querySelectorAll('.dropdown-menu-custom');

            allDropdowns.forEach(d => {

                if (d.id !== id) {

                    d.classList.remove('show');

                }

            });

            dropdown.classList.toggle('show');

        }

        // Close dropdowns on outside click
        document.addEventListener('click', function (e) {

            if (!e.target.closest('.topbar-icon') &&
                !e.target.closest('.user-dropdown') &&
                !e.target.closest('.dropdown-menu-custom')) {

                document
                    .querySelectorAll('.dropdown-menu-custom')
                    .forEach(d => d.classList.remove('show'));

            }

        });

        // Load notifications
        async function loadNotifications() {

            try {

                const response =
                    await fetch('/Home/GetNotifications');

                const data =
                    await response.json();

                document.getElementById('notifCount').textContent =
                    data.count;

                const list =
                    document.getElementById('notifList');

                if (data.items && data.items.length > 0) {

                    list.innerHTML = data.items.map(item => `

                        <div class="dropdown-item-custom notification-item">

                            <div class="notif-title">

                                <span class="notif-type-badge ${item.type?.toLowerCase() || 'feedback'}">

                                    ${item.type}

                                </span>

                                ${item.subject}

                            </div>

                            <div class="notif-message">

                                ${item.message}

                            </div>

                            <div class="notif-meta">

                                by ${item.userName} •
                                ${new Date(item.createdAt).toLocaleDateString()}

                            </div>

                        </div>

                    `).join('');

                } else {

                    list.innerHTML =
                        '<div class="dropdown-item-custom" style="text-align: center; color: var(--gray);">No notifications</div>';

                }

            } catch (err) {

                console.error(
                    'Failed to load notifications',
                    err
                );

            }

        }

        loadNotifications();

        setInterval(
            loadNotifications,
            30000
        );

    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>