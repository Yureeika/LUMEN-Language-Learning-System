@model LUMEN.Models.Lesson

@{
    ViewData["Title"] = "Create Lesson";
    var selectedSubjectId = ViewBag.SelectedSubjectId;
}

<style>
    .create-lesson-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .lesson-card {
        background: white;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        border: 1px solid #e8e8e8;
    }

    .lesson-header {
        margin-bottom: 2rem;
    }

    .lesson-header h1 {
        font-size: 2rem;
        font-weight: 700;
        color: #1E1E2E;
        margin-bottom: 0.5rem;
    }

    .lesson-header p {
        color: #6b6b6b;
        margin: 0;
    }

    .form-label {
        font-weight: 600;
        color: #1E1E2E;
        margin-bottom: 0.5rem;
    }

    .form-control,
    .form-select {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        font-size: 0.95rem;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #C65D3E;
        box-shadow: 0 0 0 0.2rem rgba(198, 93, 62, 0.15);
    }

    textarea.form-control {
        min-height: 220px;
        resize: vertical;
    }

    .form-check {
        background: #f8f8f8;
        padding: 1rem 1rem 1rem 2.5rem;
        border-radius: 8px;
    }

    .form-check-input:checked {
        background-color: #C65D3E;
        border-color: #C65D3E;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

    .btn-create {
        background: #C65D3E;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .btn-create:hover {
        background: #A84A2E;
        color: white;
        transform: translateY(-1px);
    }

    .btn-cancel {
        background: #f1f1f1;
        color: #1E1E2E;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-cancel:hover {
        background: #e2e2e2;
        color: #1E1E2E;
    }

    .field-help {
        font-size: 0.8rem;
        color: #888;
        margin-top: 0.35rem;
    }
</style>

<div class="container-fluid mt-4">
    <div class="create-lesson-container">

        <div class="lesson-header">
            <h1>Create Lesson</h1>
            <p>Add a new lesson and assign it to a subject.</p>
        </div>

        <div class="lesson-card">

            <form asp-controller="Lessons" asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <!-- Show validation errors only when there are errors -->
<div asp-validation-summary="All"
     class="alert alert-danger mb-4"
     style="@(ViewData.ModelState.IsValid ? "display:none;" : "")">
</div>

                <!-- Subject -->
                <div class="mb-4">
                    <label asp-for="SubjectId" class="form-label">
                        Subject
                    </label>

                    <select asp-for="SubjectId"
                            class="form-select"
                            asp-items="ViewBag.SubjectId">

                        <option value="0">-- Select Subject --</option>

                    </select>

                    <span asp-validation-for="SubjectId"
                          class="text-danger">
                    </span>

                    <div class="field-help">
                        Choose the subject this lesson belongs to.
                    </div>
                </div>

                <!-- Title -->
                <div class="mb-4">
                    <label asp-for="Title" class="form-label">
                        Lesson Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter lesson title..." />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>
                </div>

                <!-- Content -->
                <div class="mb-4">
                    <label asp-for="Content" class="form-label">
                        Lesson Content
                    </label>

                    <textarea asp-for="Content"
                              class="form-control"
                              rows="10"
                              placeholder="Write the lesson content here..."></textarea>

                    <span asp-validation-for="Content"
                          class="text-danger">
                    </span>
                </div>

                <!-- Video URL -->
                <div class="mb-4">
                    <label asp-for="VideoUrl" class="form-label">
                        Video URL
                    </label>

                    <input asp-for="VideoUrl"
                           class="form-control"
                           placeholder="https://www.youtube.com/embed/..." />

                    <span asp-validation-for="VideoUrl"
                          class="text-danger">
                    </span>

                    <div class="field-help">
                        Optional. Use an embeddable YouTube URL.
                    </div>
                </div>

                <!-- Order -->
                <div class="mb-4">
                    <label asp-for="OrderIndex" class="form-label">
                        Lesson Order
                    </label>

                    <input asp-for="OrderIndex"
                           class="form-control"
                           type="number"
                           min="1"
                           value="@(Model.OrderIndex == 0 ? 1 : Model.OrderIndex)"
                           placeholder="1" />

                    <span asp-validation-for="OrderIndex"
                          class="text-danger">
                    </span>

                    <div class="field-help">
                        Determines where this lesson appears in the subject.
                    </div>
                </div>

                <!-- Published -->
                <div class="mb-4">
                    <div class="form-check">

                        <input asp-for="IsPublished"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="IsPublished"
                               class="form-check-label">
                            Publish this lesson
                        </label>

                    </div>
                </div>

                <!-- Buttons -->
                <div class="form-actions">

                    <button type="submit" class="btn-create">
                        <i class="bi bi-check-circle me-1"></i>
                        Create Lesson
                    </button>

                    <a asp-controller="Lessons"
                       asp-action="Index"
                       asp-route-subjectId="@selectedSubjectId"
                       class="btn-cancel">

                        <i class="bi bi-arrow-left me-1"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}