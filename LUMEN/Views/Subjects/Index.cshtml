@model List<LUMEN.Models.Subject>
@{
    ViewData["Title"] = "Browse Subjects";
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var currentCategory = ViewBag.CurrentCategory as string;
    var search = ViewBag.Search as string;
    var enrollmentCounts = ViewBag.EnrollmentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    var userEnrollments = ViewBag.UserEnrollments as HashSet<int> ?? new HashSet<int>();
    Layout = isAdmin ? "_AdminLayout" : "_StudentLayout";
}

<div class="subjects-page">
    <div class="page-header">
        <div>
            <h1 class="page-title">
                <i class="bi bi-book-fill"></i>
                @(isAdmin ? "All Subjects" : "Browse Subjects")
            </h1>
            <p class="page-subtitle">@Model.Count subjects available</p>
        </div>

        @if (isAdmin)
        {
            <a href="/Subjects/Create" class="btn-terracotta">
                <i class="bi bi-plus-circle"></i> Add New Subject
            </a>
        }
    </div>

    <div class="filters-bar">
        <form method="get" class="filters-form">

            <div class="filter-group">
                <label>Category</label>

                <select name="category" onchange="this.form.submit()">

                    <option value="">All Categories</option>

                    @foreach (var cat in categories)
                    {
                        <option value="@cat" selected="@(cat == currentCategory)">
                            @cat
                        </option>
                    }

                </select>
            </div>


            <div class="filter-group search-group">

                <label>Search</label>

                <input type="text"
                       name="search"
                       value="@search"
                       placeholder="Search subjects..." />

            </div>

        </form>
    </div>


    @foreach (var level in new[] { "Basic", "Intermediate", "Advanced" })
    {
        var levelSubjects =
            Model.Where(s => s.Level == level).ToList();

        if (!levelSubjects.Any())
        {
            continue;
        }


        <div class="level-section">

            <div class="subjects-grid">

                @foreach (var subject in levelSubjects)
                {
                    var isEnrolled =
                        userEnrollments.Contains(subject.Id);

                    var count =
                        enrollmentCounts.ContainsKey(subject.Id)
                            ? enrollmentCounts[subject.Id]
                            : 0;


                    <div class="subject-card">

                        <div class="subject-image">

                            @if (!string.IsNullOrEmpty(subject.ImageUrl))
                            {
                                <img src="@subject.ImageUrl"
                                     alt="@subject.Title" />
                            }
                            else
                            {
                                <div class="subject-image-placeholder">

                                    <i class="bi bi-book"></i>

                                </div>
                            }


                            <span class="level-badge @subject.Level.ToLower()">
                                @subject.Level
                            </span>


                            @if (subject.Price == 0)
                            {
                                <span class="price-badge free">
                                    FREE
                                </span>
                            }
                            else
                            {
                                <span class="price-badge paid">
                                    $@subject.Price
                                </span>
                            }


                            @if (isEnrolled)
                            {
                                <span class="enrolled-badge">

                                    <i class="bi bi-check-circle-fill"></i>

                                    Enrolled

                                </span>
                            }

                        </div>


                        <div class="subject-content">

                            <span class="subject-category">
                                @subject.Category
                            </span>


                            <h3 class="subject-title">
                                @subject.Title
                            </h3>


                            <p class="subject-desc">
                                @subject.Description
                            </p>


                            <div class="subject-meta">

                                <span>

                                    <i class="bi bi-people-fill"></i>

                                    @count enrolled

                                </span>

                            </div>


                            <div class="subject-actions">

                                <a href="/Subjects/Details/@subject.Id"
                                   class="btn-view">

                                    <i class="bi bi-eye"></i>

                                    View

                                </a>


                                @if (!isAdmin)
                                {
                                    @if (isEnrolled)
                                    {
                                        <button class="btn-enroll enrolled"
                                                disabled>

                                            <i class="bi bi-check-circle"></i>

                                            Enrolled

                                        </button>
                                    }
                                    else
                                    {
                                        <form action="/Subjects/Enroll"
                                              method="post"
                                              style="margin: 0; flex: 1;">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@subject.Id" />

                                            <button type="submit"
                                                    class="btn-enroll @(subject.Price > 0 ? "paid" : "")">

                                                <i class="bi bi-plus-circle"></i>

                                                @(subject.Price > 0
                                                    ? "Enroll $" + subject.Price
                                                    : "Enroll Free")

                                            </button>

                                        </form>
                                    }
                                }
                                else
                                {
                                    <a href="/Subjects/Edit/@subject.Id"
                                       class="btn-edit">

                                        <i class="bi bi-pencil"></i>

                                        Edit

                                    </a>


                                    <form action="/Subjects/Delete/@subject.Id"
                                          method="post"
                                          style="margin: 0; flex: 1;"
                                          onsubmit="return confirm('Delete this subject?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-delete">

                                            <i class="bi bi-trash"></i>

                                            Delete

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>
    }


    @if (!Model.Any())
    {
        <div class="empty-state">

            <i class="bi bi-book"></i>

            <h3>No subjects found</h3>

            <p>
                Try adjusting your filters or search query
            </p>

        </div>
    }

</div>


<style>

    .subjects-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 1rem;
    }


    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }


    .page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1E1E2E;
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }


    .page-subtitle {
        color: #6b6b6b;
        font-size: 0.95rem;
    }


    .btn-terracotta {
        background: #C65D3E;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }


    .btn-terracotta:hover {
        background: #A84A2E;
        color: white;
    }


    .filters-bar {
        background: white;
        padding: 1.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }


    .filters-form {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        align-items: end;
    }


    .filter-group label {
        display: block;
        font-size: 0.8rem;
        font-weight: 600;
        color: #6b6b6b;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }


    .filter-group select,
    .filter-group input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #e5e5e5;
        border-radius: 6px;
        font-size: 0.9rem;
        background: white;
    }


    .filter-group select:focus,
    .filter-group input:focus {
        outline: none;
        border-color: #C65D3E;
    }


    .level-section {
        margin-bottom: 3rem;
    }


    .level-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        border-left: 4px solid;
        flex-wrap: wrap;
        gap: 0.5rem;
    }


    .level-header.basic {
        background: rgba(122, 139, 92, 0.1);
        border-color: #7A8B5C;
    }


    .level-header.intermediate {
        background: rgba(245, 158, 11, 0.1);
        border-color: #F59E0B;
    }


    .level-header.advanced {
        background: rgba(198, 93, 62, 0.1);
        border-color: #C65D3E;
    }


    .level-header h2 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1E1E2E;
        margin: 0;
    }


    .level-header p {
        margin: 0.25rem 0 0;
        font-size: 0.85rem;
        color: #6b6b6b;
    }


    .level-count {
        background: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #1E1E2E;
    }


    .subjects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }


    .subject-card {
        background: white;
        border: 1px solid #e8e5de;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
    }


    .subject-card:hover {
        transform: translateY(-4px);
        border-color: rgba(198, 93, 62, 0.25);
        box-shadow: 0 10px 30px rgba(0,0,0,0.10);
    }


    .subject-image {
        height: 180px;
        overflow: hidden;
        position: relative;
    }


    .subject-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }


    .subject-image-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #C65D3E, #7A8B5C);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 3rem;
    }


    .level-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
    }


    .level-badge.basic {
        background: #7A8B5C;
        color: white;
    }


    .level-badge.intermediate {
        background: #F59E0B;
        color: white;
    }


    .level-badge.advanced {
        background: #C65D3E;
        color: white;
    }


    .price-badge {
        position: absolute;
        top: 1rem;
        right: 1rem;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.8rem;
        font-weight: 700;
    }


    .price-badge.free {
        background: #2E7D32;
        color: white;
    }


    .price-badge.paid {
        background: #1E1E2E;
        color: white;
    }


    .enrolled-badge {
        position: absolute;
        bottom: 1rem;
        left: 1rem;
        background: rgba(46, 125, 50, 0.95);
        color: white;
        padding: 0.3rem 0.75rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.3rem;
    }


    .subject-content {
        padding: 1.5rem;
        flex: 1;
        display: flex;
        flex-direction: column;
    }


    .subject-category {
        display: inline-block;
        background: #FAF6ED;
        color: #1E1E2E;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
        align-self: flex-start;
    }


    .subject-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1E1E2E;
        margin-bottom: 0.5rem;
    }


    .subject-desc {
        color: #6b6b6b;
        font-size: 0.9rem;
        margin-bottom: 1rem;
        line-height: 1.5;
        flex: 1;
    }


    .subject-meta {
        font-size: 0.85rem;
        color: #6b6b6b;
        margin-bottom: 1rem;
    }


    .subject-meta i {
        color: #C65D3E;
    }


    .subject-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
    }


    .btn-view,
    .btn-enroll,
    .btn-edit,
    .btn-delete {
        padding: 0.6rem 1rem;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        border: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        transition: all 0.2s;
    }


    .btn-view {
        background: #FAF6ED;
        color: #1E1E2E;
    }


    .btn-view:hover {
        background: #F0E8D5;
    }


    .btn-enroll {
        background: #C65D3E;
        color: white;
    }


    .btn-enroll:hover {
        background: #A84A2E;
        color: white;
    }


    .btn-enroll.paid {
        background: #1E1E2E;
    }


    .btn-enroll.paid:hover {
        background: #2a2a3e;
        color: white;
    }


    .btn-enroll.enrolled {
        background: #2E7D32;
        color: white;
        cursor: not-allowed;
        opacity: 0.8;
    }


    .admin-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-top: 0.75rem;
        padding-top: 0.75rem;
        border-top: 1px solid #f5f5f5;
    }


    .btn-edit {
        background: rgba(122, 139, 92, 0.1);
        color: #7A8B5C;
    }


    .btn-edit:hover {
        background: rgba(122, 139, 92, 0.2);
    }


    .btn-delete {
        background: rgba(220, 38, 38, 0.1);
        color: #DC2626;
    }


    .btn-delete:hover {
        background: rgba(220, 38, 38, 0.2);
    }


    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: #6b6b6b;
    }


    .empty-state i {
        font-size: 4rem;
        margin-bottom: 1rem;
        display: block;
    }


    .empty-state h3 {
        margin: 1rem 0 0.5rem;
        color: #1E1E2E;
    }


    @@media (max-width: 768px) {

        .subjects-grid {
            grid-template-columns: 1fr;
        }

        .filters-form {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-direction: column;
            gap: 1rem;
        }

        .page-title {
            font-size: 1.5rem;
        }

    }

</style>