@model IEnumerable<LUMEN.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";

    bool isAdmin =
        User.IsInRole("SuperAdmin") ||
        User.IsInRole("Admin");
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

            <div>
                <h1>
                    <i class="bi bi-megaphone-fill"></i>
                    Announcements
                </h1>

                <p>
                    Stay updated with the latest announcements from LUMEN.
                </p>
            </div>

            @if (isAdmin)
            {
                <button class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#createAnnouncementModal">

                    <i class="bi bi-plus-circle"></i>
                    Create Announcement

                </button>
            }

        </div>
    </div>


    <!-- Announcements -->
    @if (Model.Any())
    {
        <div class="row">

            @foreach (var announcement in Model)
            {
                <div class="col-12 mb-3">

                    <div class="card announcement-card">

                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-start gap-3">

                                <div class="flex-grow-1">

                                    <div class="d-flex align-items-center gap-2 mb-2">

                                        <h4 class="mb-0">
                                            @announcement.Title
                                        </h4>

                                        @if (isAdmin)
                                        {
                                            <span class="badge @(announcement.IsActive
                                                ? "bg-success"
                                                : "bg-secondary")">

                                                @(announcement.IsActive
                                                    ? "Active"
                                                    : "Inactive")

                                            </span>
                                        }

                                    </div>

                                    <p class="announcement-content mb-3">
                                        @announcement.Content
                                    </p>

                                    <div class="announcement-meta">

                                        <i class="bi bi-person-circle"></i>

                                        @if (announcement.CreatedBy != null)
                                        {
                                            <span>
                                                @announcement.CreatedBy.FirstName
                                                @announcement.CreatedBy.LastName
                                            </span>
                                        }
                                        else
                                        {
                                            <span>Administrator</span>
                                        }

                                        <span class="mx-2">•</span>

                                        <i class="bi bi-calendar3"></i>

                                        <span>
                                            @announcement.CreatedAt.ToLocalTime()
                                                .ToString("MMM dd, yyyy HH:mm")
                                        </span>

                                    </div>

                                </div>


                                @if (isAdmin)
                                {
                                    <div class="announcement-actions">

                                        <form asp-action="ToggleActive"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@announcement.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm @(announcement.IsActive
                                                        ? "btn-warning"
                                                        : "btn-success")">

                                                <i class="bi @(announcement.IsActive
                                                    ? "bi-toggle-off"
                                                    : "bi-toggle-on")"></i>

                                                @(announcement.IsActive
                                                    ? "Deactivate"
                                                    : "Activate")

                                            </button>

                                        </form>

                                    </div>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card">

            <div class="card-body text-center py-5">

                <i class="bi bi-megaphone"
                   style="font-size: 3rem; color: var(--olive);">
                </i>

                <h4 class="mt-3">
                    No announcements
                </h4>

                <p class="text-muted mb-0">
                    There are currently no announcements available.
                </p>

            </div>

        </div>
    }

</div>


<!-- CREATE ANNOUNCEMENT MODAL -->
@if (isAdmin)
{
    <div class="modal fade"
         id="createAnnouncementModal"
         tabindex="-1"
         aria-labelledby="createAnnouncementModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title"
                        id="createAnnouncementModalLabel">

                        <i class="bi bi-megaphone-fill"></i>
                        Create Announcement

                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>

                </div>


                <form asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="modal-body">

                        <div class="mb-3">

                            <label class="form-label">
                                Title
                            </label>

                            <input type="text"
                                   name="Title"
                                   class="form-control"
                                   placeholder="Announcement title"
                                   required />

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Content
                            </label>

                            <textarea name="Content"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Write your announcement..."
                                      required></textarea>

                        </div>


                        <div class="form-check">

                            <input type="checkbox"
                                   name="IsActive"
                                   value="true"
                                   class="form-check-input"
                                   id="isActive"
                                   checked />

                            <label class="form-check-label"
                                   for="isActive">

                                Publish immediately

                            </label>

                        </div>

                    </div>


                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-plus-circle"></i>
                            Create Announcement

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>
}


<style>

    .announcement-card {
        transition: all 0.2s ease;
    }

    .announcement-card:hover {
        transform: translateY(-2px);
    }

    .announcement-content {
        font-size: 1rem;
        line-height: 1.7;
        white-space: pre-wrap;
    }

    .announcement-meta {
        color: var(--gray);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
    }

    .announcement-actions {
        flex-shrink: 0;
    }

    .modal-content {
        border-radius: 12px;
        border: 1px solid var(--light-gray);
    }

    .modal-header {
        border-bottom: 1px solid var(--light-gray);
    }

    .modal-footer {
        border-top: 1px solid var(--light-gray);
    }

</style>