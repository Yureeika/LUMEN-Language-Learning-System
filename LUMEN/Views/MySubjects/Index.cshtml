@model IEnumerable<LUMEN.Models.Enrollment>

@{
    ViewData["Title"] = "My Subjects";
}

<div class="container mt-4">

    <div class="page-header">
        <h1>
            <i class="bi bi-book"></i> My Subjects
        </h1>
        <p>
            Subjects you are currently enrolled in.
        </p>
    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            @foreach (var enrollment in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100">

                        <div class="card-body">

                            <div class="d-flex align-items-center mb-3">

                                <div class="me-3"
                                     style="
                                        width:48px;
                                        height:48px;
                                        border-radius:10px;
                                        background:var(--terracotta-light);
                                        display:flex;
                                        align-items:center;
                                        justify-content:center;
                                     ">

                                    <i class="bi bi-book-fill"
                                       style="font-size:1.4rem; color:var(--terracotta);">
                                    </i>

                                </div>

                                <div>
                                    <h5 class="card-title mb-1">
                                        @enrollment.Subject.Title
                                    </h5>

                                    <small class="text-muted">
                                        Enrolled
                                    </small>
                                </div>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(enrollment.Subject.Description))
                            {
                                <p class="card-text text-muted">
                                    @enrollment.Subject.Description
                                </p>
                            }


                            <div class="mb-3">

                                <div class="d-flex justify-content-between mb-1">

                                    <small class="text-muted">
                                        Progress
                                    </small>

                                    <small class="text-muted">
                                        @(enrollment.IsCompleted ? "100%" : "0%")
                                    </small>

                                </div>

                                <div class="progress">

                                    <div class="progress-bar"
                                         role="progressbar"
                                         style="width:@(enrollment.IsCompleted ? 100 : 0)%">
                                    </div>

                                </div>

                            </div>


                           <a asp-controller="Lessons"
   asp-action="Index"
   asp-route-subjectId="@enrollment.SubjectId"
   class="btn btn-primary">

    Continue Learning
    <i class="bi bi-arrow-right"></i>

</a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="card">

            <div class="card-body text-center py-5">

                <i class="bi bi-book"
                   style="font-size:3rem; color:var(--olive);">
                </i>

                <h3 class="mt-3">
                    No subjects yet
                </h3>

                <p class="text-muted">
                    You are not enrolled in any subjects yet.
                </p>

                <a asp-controller="Subjects"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-search"></i>
                    Browse Subjects

                </a>

            </div>

        </div>
    }

</div>