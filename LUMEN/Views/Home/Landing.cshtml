    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      
        
        // Modal functions
        function openModal(tab) {
            document.getElementById('authModal').classList.add('active');
            document.body.style.overflow = 'hidden';
            switchTab(tab || 'login');
        }
        
        function closeModal() {
            document.getElementById('authModal').classList.remove('active');
            document.body.style.overflow = 'auto';
        }
        
        function switchTab(tab) {
            const loginForm = document.getElementById('loginForm');
            const registerForm = document.getElementById('registerForm');
            const loginTab = document.getElementById('loginTab');
            const registerTab = document.getElementById('registerTab');
            const subtitle = document.getElementById('modalSubtitle');
            
            if (tab === 'login') {
                loginForm.style.display = 'block';
                registerForm.style.display = 'none';
                loginTab.classList.add('active');
                registerTab.classList.remove('active');
                subtitle.textContent = 'Welcome back! Please login to your account.';
            } else {
                loginForm.style.display = 'none';
                registerForm.style.display = 'block';
                loginTab.classList.remove('active');
                registerTab.classList.add('active');
                subtitle.textContent = 'Create your account and start learning today!';
            }
        }
        
        // Scroll to section
        function scrollToSection(sectionId) {
            const element = document.getElementById(sectionId);
            if (element) {
                element.scrollIntoView({ behavior: 'smooth' });
            }
        }
        
        // Close modal on outside click
        document.getElementById('authModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeModal();
            }
        });
        
        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeModal();
            }
        });
         // Handle category card selection
    document.querySelectorAll('.category-card').forEach(card => {
        card.addEventListener('click', function() {
            this.classList.toggle('selected');
            updateHiddenCategories();
        });
    });

    function updateHiddenCategories() {
        const selected = document.querySelectorAll('.category-card.selected');
        const values = Array.from(selected).map(c => c.dataset.value);
        
        // Remove old hidden inputs
        document.querySelectorAll('input[name="Categories"]').forEach(i => i.remove());
        
        // Add new hidden inputs
        const form = document.getElementById('registerForm');
        values.forEach(v => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'Categories';
            input.value = v;
            form.appendChild(input);
        });
    }
    // Category selection for registration
function toggleCategory(element, value) {
    element.classList.toggle('selected');
    updateCategoryInputs();
}

function updateCategoryInputs() {
    const selected = document.querySelectorAll('.category-card.selected');
    const values = Array.from(selected).map(c => c.getAttribute('data-value'));
    
    // Remove old hidden inputs
    document.querySelectorAll('input[name="Categories"]').forEach(i => i.remove());
    
    // Add new hidden inputs to the register form
    const form = document.getElementById('registerForm');
    if (form) {
        values.forEach(v => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'Categories';
            input.value = v;
            form.appendChild(input);
        });
    }
}

// Also update openModal to handle category selection
const originalOpenModal = window.openModal;
window.openModal = function(type) {
    if (originalOpenModal) originalOpenModal(type);
    
    // If opening register modal, ensure form exists
    if (type === 'register') {
        setTimeout(() => {
            const form = document.getElementById('registerForm');
            if (form && !form.querySelector('input[name="Categories"]')) {
                // Form exists but no categories selected yet - that's OK
            }
        }, 100);
    }
};
    </script>
