@model LUMEN.ViewModels.ChatViewModel

@{
    ViewData["Title"] = "Chat";
}

<div class="container-fluid mt-4">

    <div class="page-header">
        <h1>
            <i class="bi bi-chat-dots"></i>
            Live Chat
        </h1>

        <p>
            Chat in real-time with other students.
        </p>
    </div>


    <div class="row mt-4">

        <!-- CHAT ROOMS -->
        <div class="col-md-3">

            <div class="card">

                <div class="card-header">
                    <h5 class="mb-0">
                        Chat Rooms
                    </h5>
                </div>

                <div class="list-group list-group-flush">

                    @if (Model.AvailableRooms.Any())
                    {
                        @foreach (var room in Model.AvailableRooms)
                        {
                            <a href="#"
                               class="list-group-item list-group-item-action room-link @(room.Id == Model.CurrentRoom.Id ? "active" : "")"
                               data-room-id="@room.Id"
                               data-room-name="@room.Name">

                                <i class="bi bi-hash"></i>

                                @room.Name

                            </a>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-muted">
                            No chat rooms available.
                        </div>
                    }

                </div>

            </div>


            <!-- ONLINE USERS -->

            <div class="card mt-3">

                <div class="card-header">
                    <h5 class="mb-0">
                        Online Users
                    </h5>
                </div>

                <div class="card-body">

                    <div id="onlineUsers">

                        @if (Model.OnlineUsers.Any())
                        {
                            @foreach (var onlineUser in Model.OnlineUsers)
                            {
                                <div class="mb-2">
                                    <i class="bi bi-circle-fill text-success"
                                       style="font-size: 0.55rem;"></i>

                                    @onlineUser.FirstName
                                    @onlineUser.LastName
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                No other users online.
                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- CHAT AREA -->

        <div class="col-md-9">

            <div class="card">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 id="currentRoomName" class="mb-0">

                        <i class="bi bi-hash"></i>

                        @Model.CurrentRoom.Name

                    </h5>


                    <span class="badge bg-success"
                          id="connectionStatus">

                        Connected

                    </span>

                </div>


                <div id="chatMessages"
                     class="card-body"
                     style="height: 500px; overflow-y: auto; background-color: #f8f9fa;">

                    @if (Model.Messages.Any())
                    {
                        @foreach (var msg in Model.Messages)
                        {
                            var isCurrentUser =
                                msg.UserId == Model.CurrentUserId;

                            <div class="mb-3 @(isCurrentUser ? "text-end" : "")">

                                <div class="d-inline-block p-3 rounded @(isCurrentUser ? "bg-primary text-white" : "bg-white border")"
                                     style="max-width: 75%;">

                                    <strong>
                                        @msg.User.FirstName
                                        @msg.User.LastName
                                    </strong>

                                    <p class="mb-1">
                                        @msg.Content
                                    </p>

                                    <small class="@(isCurrentUser ? "text-white-50" : "text-muted")">

                                        @msg.SentAt.ToString("HH:mm")

                                    </small>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted mt-5">

                            <i class="bi bi-chat-square-text display-4"></i>

                            <p class="mt-3">
                                No messages yet.
                                Start the conversation!
                            </p>

                        </div>
                    }

                </div>


                <!-- MESSAGE FORM -->

                <div class="card-footer">

                    <form id="chatForm">

                        <div class="input-group">

                            <input type="text"
                                   id="messageInput"
                                   class="form-control"
                                   placeholder="Type your message..."
                                   autocomplete="off" />

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-send"></i>

                                Send

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script src="~/js/chat.js"></script>

    <script>
        if (typeof initChat === "function") {

            initChat(
                @Model.CurrentRoom.Id,
                '@Model.CurrentUserId',
                '@User.Identity?.Name'
            );

        }
    </script>

}