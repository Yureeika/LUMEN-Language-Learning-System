@model IEnumerable<LUMEN.Models.Notification>
    @{
    ViewData["Title"] = "Notifications";
    }

    <div class="container mt-4">
        <h1><i class="bi bi-bell"></i> Notifications</h1>

        @if (Model.Any())
        {
        <div class="list-group mt-4">
            @foreach (var notification in Model)
            {
            <div class="list-group-item @(notification.IsRead ? " " : " bg-light border-start border-primary border-3")">
                <div class="d-flex justify-content-between">
                    <h5 class="mb-1">@notification.Title</h5>
                    <small class="text-muted">@notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                </div>
                <p class="mb-1">@notification.Message</p>
                @if (!string.IsNullOrEmpty(notification.Link))
                {
                <a href="@notification.Link" class="btn btn-sm btn-primary">View Details</a>
                }
                @if (!notification.IsRead)
                {
                <button onclick="markAsRead(@notification.Id)" class="btn btn-sm btn-secondary ms-2">Mark as Read</button>
                }
            </div>
            }
        </div>
        }
        else
        {
        <div class="alert alert-info mt-4">
            <i class="bi bi-info-circle"></i> No notifications yet.
        </div>
        }
    </div>

    @section Scripts {
    <script>
        function markAsRead(id) {
            fetch('/Notifications/MarkAsRead?id=' + id, { method: 'POST' })
                .then(() => location.reload());
        }
    </script>
    }
