@model LUMEN.Models.Quiz

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewData["Title"] = "Quiz Result";

    int score = ViewBag.Score;
    int correctAnswers = ViewBag.CorrectAnswers;
    int totalQuestions = ViewBag.TotalQuestions;
    bool passed = ViewBag.Passed;
}

<div class="container mt-5 mb-5">

    <div class="card shadow-sm">

        <div class="card-body text-center p-5">

            @if (passed)
            {
                <div class="mb-4">

                    <i class="bi bi-check-circle-fill text-success"
                       style="font-size: 64px;"></i>

                </div>

                <h1 class="text-success">
                    Quiz Passed!
                </h1>
            }
            else
            {
                <div class="mb-4">

                    <i class="bi bi-x-circle-fill text-danger"
                       style="font-size: 64px;"></i>

                </div>

                <h1 class="text-danger">
                    Quiz Not Passed
                </h1>
            }

            <h3 class="mt-4">
                @Model.Title
            </h3>


            <div class="row justify-content-center mt-4">

                <div class="col-md-3">

                    <div class="card bg-light">

                        <div class="card-body">

                            <h6>Score</h6>

                            <h2>
                                @score%
                            </h2>

                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="card bg-light">

                        <div class="card-body">

                            <h6>Correct</h6>

                            <h2>
                                @correctAnswers / @totalQuestions
                            </h2>

                        </div>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="card bg-light">

                        <div class="card-body">

                            <h6>Required</h6>

                            <h2>
                                @Model.PassingScore%
                            </h2>

                        </div>

                    </div>

                </div>

            </div>


            <div class="mt-5">

                <a asp-controller="DailyQuiz"
                   asp-action="Index"
                   class="btn btn-primary">

                    Back to Daily Quiz

                </a>

            </div>

        </div>

    </div>

</div>