
@model LUMEN.Models.Quiz

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Create Quiz";
}

<div class="page-header">
    <div>
        <h1>Create Quiz</h1>
        <p>Create a quiz for one of your lessons.</p>
    </div>
</div>

<div class="card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Title">Quiz Title</label>
            <input asp-for="Title" class="form-control" placeholder="Enter quiz title" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LessonId">Lesson</label>
            <select asp-for="LessonId"
                    asp-items="ViewBag.Lessons"
                    class="form-control">
                <option value="">-- Select Lesson --</option>
            </select>
            <span asp-validation-for="LessonId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="Describe this quiz"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="TimeLimitMinutes">Time Limit (minutes)</label>
            <input asp-for="TimeLimitMinutes"
                   type="number"
                   class="form-control"
                   min="1" />
        </div>

        <div class="form-group">
            <label asp-for="PassingScore">Passing Score (%)</label>
            <input asp-for="PassingScore"
                   type="number"
                   class="form-control"
                   min="0"
                   max="100" />
        </div>

        <div class="form-check">
            <input asp-for="IsPublished" class="form-check-input" />
            <label asp-for="IsPublished" class="form-check-label">
                Publish Quiz
            </label>
        </div>

        <div style="margin-top: 24px;">
            <button type="submit" class="btn btn-primary">
                Create Quiz
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}