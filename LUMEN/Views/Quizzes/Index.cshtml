@model IEnumerable<LUMEN.Models.Quiz>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quizzes";
}

<div class="container-fluid mt-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Quizzes</h1>

            <p class="text-muted mb-0">
                Create quizzes and add questions manually.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Quizzes"
               asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Add Quiz
            </a>

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">

                <i class="bi bi-question-circle"
                   style="font-size: 48px;">
                </i>

                <h3 class="mt-3">
                    No quizzes yet
                </h3>

                <p class="text-muted">
                    Create a quiz first, then add questions to it.
                </p>

                <a asp-controller="Quizzes"
                   asp-action="Create"
                   class="btn btn-primary">
                    Create First Quiz
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>
                            <tr>

                                <th class="px-4">
                                    Quiz
                                </th>

                                <th>
                                    Lesson
                                </th>

                                <th>
                                    Questions
                                </th>

                                <th>
                                    Time Limit
                                </th>

                                <th>
                                    Passing Score
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end px-4">
                                    Actions
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var quiz in Model)
                        {
                            <tr>

                                <td class="px-4">

                                    <strong>
                                        @quiz.Title
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(quiz.Description))
                                    {
                                        <div class="text-muted small mt-1">
                                            @quiz.Description
                                        </div>
                                    }

                                </td>

                                <td>
                                    @(quiz.Lesson?.Title ?? "Unknown Lesson")
                                </td>

                                <td>

                                    @if (quiz.Questions.Count > 0)
                                    {
                                        <span class="badge bg-success">
                                            @quiz.Questions.Count
                                            question@(quiz.Questions.Count == 1 ? "" : "s")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            No questions
                                        </span>
                                    }

                                </td>

                                <td>
                                    @quiz.TimeLimitMinutes min
                                </td>

                                <td>
                                    @quiz.PassingScore%
                                </td>

                                <td>

                                    @if (quiz.IsPublished)
                                    {
                                        <span class="badge bg-success">
                                            Published
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Draft
                                        </span>
                                    }

                                </td>

                                <td class="text-end px-4">

                                    <div class="d-flex justify-content-end gap-2">

                                        <a asp-controller="Questions"
                                           asp-action="Index"
                                           asp-route-quizId="@quiz.Id"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-list-check"></i>
                                            Questions
                                        </a>

                                        <form asp-controller="Quizzes"
                                              asp-action="Delete"
                                              asp-route-id="@quiz.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Delete this quiz and all of its questions?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">

                                                <i class="bi bi-trash"></i>
                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>