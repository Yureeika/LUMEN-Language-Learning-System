@model LUMEN.Models.Question

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var quiz = ViewBag.Quiz as LUMEN.Models.Quiz;

    ViewData["Title"] = "Edit Question";
}

<div class="page-header">

    <div>

        <h1>Edit Question</h1>

        @if (quiz != null)
        {
            <p>
                Quiz: <strong>@quiz.Title</strong>
            </p>
        }

    </div>

</div>

<div class="card">

    <form asp-controller="Questions"
          asp-action="Edit"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="Id" />

        <input type="hidden"
               asp-for="QuizId" />

        <div asp-validation-summary="All"
             class="alert alert-danger">
        </div>

        <div class="form-group">

            <label asp-for="QuestionText">
                Question
            </label>

            <textarea asp-for="QuestionText"
                      class="form-control"
                      rows="4"></textarea>

            <span asp-validation-for="QuestionText"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="OptionA">
                Option A
            </label>

            <input asp-for="OptionA"
                   class="form-control" />

            <span asp-validation-for="OptionA"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="OptionB">
                Option B
            </label>

            <input asp-for="OptionB"
                   class="form-control" />

            <span asp-validation-for="OptionB"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="OptionC">
                Option C
            </label>

            <input asp-for="OptionC"
                   class="form-control" />

            <span asp-validation-for="OptionC"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="OptionD">
                Option D
            </label>

            <input asp-for="OptionD"
                   class="form-control" />

            <span asp-validation-for="OptionD"
                  class="text-danger">
            </span>

        </div>

        <div class="form-group">

            <label asp-for="CorrectAnswer">
                Correct Answer
            </label>

            <select asp-for="CorrectAnswer"
                    class="form-control">

                <option value="A">Option A</option>
                <option value="B">Option B</option>
                <option value="C">Option C</option>
                <option value="D">Option D</option>

            </select>

            <span asp-validation-for="CorrectAnswer"
                  class="text-danger">
            </span>

        </div>

        <div style="margin-top: 24px;">

            <button type="submit"
                    class="btn btn-primary">
                Save Changes
            </button>

            <a asp-controller="Questions"
               asp-action="Index"
               asp-route-quizId="@Model.QuizId"
               class="btn btn-secondary">

                Cancel

            </a>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}