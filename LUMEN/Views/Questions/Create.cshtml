@model LUMEN.Models.Question

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var quiz = ViewBag.Quiz as LUMEN.Models.Quiz;

    ViewData["Title"] = "Add Question";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Test - Add Question</h1>

            @if (quiz != null)
            {
                <p class="text-muted mb-0">
                    Adding a question to:
                    <strong>@quiz.Title</strong>
                </p>

                @if (quiz.Lesson != null)
                {
                    <small class="text-muted">
                        Lesson: @quiz.Lesson.Title
                    </small>
                }
            }
        </div>

        <div>
            @if (quiz != null)
            {
                <a asp-controller="Questions"
                   asp-action="Index"
                   asp-route-quizId="@quiz.Id"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i>
                    Back to Questions
                </a>
            }
        </div>

    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">
                Question Details
            </h5>
        </div>

        <div class="card-body">

            <form asp-controller="Questions"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="QuizId" />

                <!-- Question -->
                <div class="mb-4">

                    <label asp-for="QuestionText"
                           class="form-label fw-semibold">
                        Question
                    </label>

                    <textarea asp-for="QuestionText"
                              class="form-control"
                              rows="4"
                              placeholder="Enter the question..."
                              required></textarea>

                    <span asp-validation-for="QuestionText"
                          class="text-danger">
                    </span>

                </div>

                <!-- Option A -->
                <div class="mb-3">

                    <label asp-for="OptionA"
                           class="form-label fw-semibold">
                        Option A
                    </label>

                    <input asp-for="OptionA"
                           class="form-control"
                           placeholder="Enter option A..."
                           required />

                    <span asp-validation-for="OptionA"
                          class="text-danger">
                    </span>

                </div>

                <!-- Option B -->
                <div class="mb-3">

                    <label asp-for="OptionB"
                           class="form-label fw-semibold">
                        Option B
                    </label>

                    <input asp-for="OptionB"
                           class="form-control"
                           placeholder="Enter option B..."
                           required />

                    <span asp-validation-for="OptionB"
                          class="text-danger">
                    </span>

                </div>

                <!-- Option C -->
                <div class="mb-3">

                    <label asp-for="OptionC"
                           class="form-label fw-semibold">
                        Option C
                    </label>

                    <input asp-for="OptionC"
                           class="form-control"
                           placeholder="Enter option C..."
                           required />

                    <span asp-validation-for="OptionC"
                          class="text-danger">
                    </span>

                </div>

                <!-- Option D -->
                <div class="mb-4">

                    <label asp-for="OptionD"
                           class="form-label fw-semibold">
                        Option D
                    </label>

                    <input asp-for="OptionD"
                           class="form-control"
                           placeholder="Enter option D..."
                           required />

                    <span asp-validation-for="OptionD"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <!-- Correct Answer -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="CorrectAnswer"
                               class="form-label fw-semibold">
                            Correct Answer
                        </label>

                        <select asp-for="CorrectAnswer"
                                class="form-select"
                                required>

                            <option value="A">Option A</option>
                            <option value="B">Option B</option>
                            <option value="C">Option C</option>
                            <option value="D">Option D</option>

                        </select>

                        <div class="form-text">
                            Select which option is correct.
                        </div>

                        <span asp-validation-for="CorrectAnswer"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Points -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="Points"
                               class="form-label fw-semibold">
                            Points
                        </label>

                        <input asp-for="Points"
                               type="number"
                               class="form-control"
                               min="1"
                               max="100"
                               value="1"
                               required />

                        <div class="form-text">
                            Points awarded when the learner answers
                            this question correctly.
                        </div>

                        <span asp-validation-for="Points"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-plus-circle"></i>
                        Add Question

                    </button>

                    @if (quiz != null)
                    {
                        <a asp-controller="Questions"
                           asp-action="Index"
                           asp-route-quizId="@quiz.Id"
                           class="btn btn-secondary">

                            Cancel

                        </a>
                    }

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}