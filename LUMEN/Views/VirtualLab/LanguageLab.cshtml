@{
    ViewData["Title"] = "Language Lab";
}

<div class="container-fluid mt-4">
    <h1><i class="bi bi-translate"></i> Language Lab</h1>
    <p class="text-muted">Practice translation with multiple languages</p>

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Translation Exercise</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Translate from:</label>
                        <select id="sourceLanguage" class="form-select">
                            <option value="en">English</option>
                            <option value="es">Spanish</option>
                            <option value="fr">French</option>
                            <option value="de">German</option>
                            <option value="it">Italian</option>
                            <option value="pt">Portuguese</option>
                            <option value="zh">Chinese</option>
                            <option value="ja">Japanese</option>
                            <option value="ko">Korean</option>
                            <option value="ar">Arabic</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Translate to:</label>
                        <select id="targetLanguage" class="form-select">
                            <option value="es">Spanish</option>
                            <option value="en">English</option>
                            <option value="fr">French</option>
                            <option value="de">German</option>
                            <option value="it">Italian</option>
                            <option value="pt">Portuguese</option>
                            <option value="zh">Chinese</option>
                            <option value="ja">Japanese</option>
                            <option value="ko">Korean</option>
                            <option value="ar">Arabic</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Text to translate:</label>
                        <textarea id="inputText" class="form-control" rows="3" placeholder="Type any text you want to translate..."></textarea>
                    </div>
                    <button id="translateBtn" class="btn btn-primary">
                        <i class="bi bi-translate"></i> Translate
                    </button>
                    <div id="translationResult" class="mt-3 alert alert-info" style="display: none;">
                        <strong>Translation:</strong>
                        <p id="translatedText" class="mb-0"></p>
                    </div>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5>Practice Mode</h5>
                </div>
                <div class="card-body">
                    <p class="lead" id="exerciseText">Loading exercise...</p>
                    <input type="text" id="userAnswer" class="form-control mb-3" placeholder="Type your translation..." />
                    <button id="checkAnswerBtn" class="btn btn-primary">Check Answer</button>
                    <button id="nextExerciseBtn" class="btn btn-secondary">Next Exercise</button>
                    <div id="feedbackContainer" class="mt-3"></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Your Progress</h5>
                </div>
                <div class="card-body">
                    <p>Exercises Completed: <span id="completedCount">0</span></p>
                    <p>Correct Answers: <span id="correctCount">0</span></p>
                    <p>XP Earned: <span id="xpEarned">0</span></p>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5>Language Tips</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li><i class="bi bi-check-circle text-success"></i> Practice daily</li>
                        <li><i class="bi bi-check-circle text-success"></i> Start with simple phrases</li>
                        <li><i class="bi bi-check-circle text-success"></i> Use context clues</li>
                        <li><i class="bi bi-check-circle text-success"></i> Don't fear mistakes</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/language-lab.js"></script>
}