@{
    ViewData["Title"] = "Virtual Lab";
}

<div class="container-fluid mt-4">

    <div class="row">

        <!-- ========================================================= -->
        <!-- CODE EDITOR -->
        <!-- ========================================================= -->

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">
                        Code Editor
                    </h5>

                    <button id="runCodeBtn"
                            type="button"
                            class="btn btn-success">
                        Run Code
                    </button>

                </div>

                <div class="card-body p-0">

                    <div id="codeEditor"
                         style="height: 450px;">
                    </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- PROGRAM INPUT -->
            <!-- ===================================================== -->

            <div class="card mt-3 shadow-sm">

                <div class="card-header">

                    <h5 class="mb-0">
                        Program Input
                    </h5>

                </div>

                <div class="card-body">

                    <p class="text-muted mb-2">
                        If your Python program uses
                        <code>input()</code>,
                        enter one input value per line.
                    </p>

                    <textarea id="programInput"
                              class="form-control"
                              rows="7"
                              spellcheck="false"
                              placeholder="Example:
                    Meow
                    21"></textarea>

                    <small class="text-muted d-block mt-2">
                        Example: Meow on line 1 and 21 on line 2.
                    </small>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- OUTPUT -->
            <!-- ===================================================== -->

            <div class="card mt-3 shadow-sm">

                <div class="card-header d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">
                        Output
                    </h5>

                    <button id="clearOutputBtn"
                            type="button"
                            class="btn btn-outline-secondary btn-sm">
                        Clear
                    </button>

                </div>

                <div class="card-body p-0">

                    <pre id="output"
                         class="bg-dark text-light p-3 mb-0"
                         style="
                    min-height: 180px;
                    white-space: pre-wrap;
                    overflow-x: auto;
                    font-family: Consolas, Monaco, monospace;
                    ">Click "Run Code" to execute your Python program.</pre>

                </div>

            </div>

        </div>


        <!-- ========================================================= -->
        <!-- CHALLENGE -->
        <!-- ========================================================= -->

        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-header">

                    <h5 class="mb-0">
                        Challenge
                    </h5>

                </div>

                <div class="card-body">

                    <h6>
                        Python Challenge
                    </h6>

                    <p id="challengeDescription">
                        Write a function that adds two numbers.
                    </p>

                    <hr>

                    <p class="text-muted mb-0">
                        Your code runs inside a Docker sandbox
                        with restricted network access and
                        limited system resources.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>

    <script src="~/js/coding-lab.js?v=2"></script>
}